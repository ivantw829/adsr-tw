---
import '@/styles/global.css';
import Navbar from '@/components/Navbar.astro';
import Footer from '@/components/Footer.astro';
import { withBase, toAbsoluteUrl } from '@/utils/url';
import {
  SITE_SEO,
  buildBaseGraph,
  buildBreadcrumbJsonLd,
  type ArticleMeta,
  type BreadcrumbItem,
} from '@/utils/seo';

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  articleMeta?: ArticleMeta;
  breadcrumbs?: BreadcrumbItem[];
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  title,
  description = SITE_SEO.defaultDescription,
  ogImage = SITE_SEO.defaultOgImage,
  ogImageAlt = SITE_SEO.defaultOgImageAlt,
  ogImageWidth = SITE_SEO.ogImageWidth,
  ogImageHeight = SITE_SEO.ogImageHeight,
  ogType = 'website',
  noindex = false,
  articleMeta,
  breadcrumbs,
  jsonLd,
} = Astro.props;

const siteUrl = Astro.site ?? new URL('https://adsr.asdtw.org');
const normalizedPathname =
  Astro.url.pathname === '/' || /\.[a-z0-9]+$/i.test(Astro.url.pathname)
    ? Astro.url.pathname
    : Astro.url.pathname.endsWith('/')
      ? Astro.url.pathname
      : `${Astro.url.pathname}/`;
const canonicalUrl = new URL(normalizedPathname, siteUrl).toString();
const resolvedOgImage = toAbsoluteUrl(ogImage, siteUrl);
const isExternalOgImage = /^https?:\/\//i.test(ogImage);
const ogImageMimeType = resolvedOgImage.endsWith('.jpg') || resolvedOgImage.endsWith('.jpeg')
  ? 'image/jpeg'
  : resolvedOgImage.endsWith('.webp')
    ? 'image/webp'
    : 'image/png';

const robotsContent = noindex
  ? 'noindex, nofollow'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';

const extraNodes = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const graphNodes: Array<Record<string, unknown>> = [
  ...buildBaseGraph(siteUrl),
  ...(breadcrumbs && breadcrumbs.length > 0 ? [buildBreadcrumbJsonLd(breadcrumbs, siteUrl)] : []),
  ...extraNodes,
];

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': graphNodes,
};
---

<!doctype html>
<html lang="zh-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="學生權益, 學權, 教育改革, 學生運動, 台灣, ADSR, 捍衛全台學權行動, 學生組織, 民主, 反威權, 學生自主"
    />
    <meta name="robots" content={robotsContent} />
    <meta name="theme-color" content={SITE_SEO.themeColor} />
    <meta name="color-scheme" content="dark" />
    <meta name="author" content={SITE_SEO.siteName} />
    {!noindex && <link rel="canonical" href={canonicalUrl} />}

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:type" content={ogType} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:secure_url" content={resolvedOgImage} />
    <meta property="og:image:type" content={ogImageMimeType} />
    {
      !isExternalOgImage && (
        <>
          <meta property="og:image:width" content={String(ogImageWidth)} />
          <meta property="og:image:height" content={String(ogImageHeight)} />
        </>
      )
    }
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content={SITE_SEO.locale} />
    <meta property="og:site_name" content={SITE_SEO.siteName} />

    {
      ogType === 'article' && articleMeta && (
        <>
          <meta property="article:published_time" content={articleMeta.publishedTime} />
          {articleMeta.modifiedTime && (
            <meta property="article:modified_time" content={articleMeta.modifiedTime} />
          )}
          {articleMeta.author && <meta property="article:author" content={articleMeta.author} />}
          {articleMeta.section && <meta property="article:section" content={articleMeta.section} />}
          {articleMeta.tags?.map((tag) => (
            <meta property="article:tag" content={tag} />
          ))}
        </>
      )
    }

    <!-- Twitter / X Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Icons & Web App Manifest -->
    <link rel="icon" href={withBase('/favicon.ico')} sizes="any" />
    <link rel="icon" type="image/png" sizes="192x192" href={withBase('/assets/icon-192.png')} />
    <link rel="apple-touch-icon" sizes="180x180" href={withBase('/assets/apple-touch-icon.png')} />
    <link rel="manifest" href={withBase('/site.webmanifest')} />

    <!-- Google Fonts (動態子集，取代 36MB 本地 TTF) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800&family=Noto+Sans+TC:wght@400;500;700;900&family=Noto+Serif+TC:wght@400;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>

  <body class="min-h-screen flex flex-col bg-[#090b10] text-gray-100 antialiased">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:rounded-lg focus:bg-red-600 focus:px-4 focus:py-2 focus:text-sm focus:font-bold focus:text-white"
    >
      跳至主要內容
    </a>

    <Navbar />

    <main id="main-content" class="flex-1 pt-16">
      <slot />
    </main>

    <Footer />
  </body>
</html>
