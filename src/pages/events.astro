---
import BaseLayout from '@/layouts/BaseLayout.astro';
import eventsData from '@/data/events.json';
import { getCategoryColor, normalizeCategory } from '@/utils/categories';

const events = [...eventsData].sort((a, b) => b.date.localeCompare(a.date));

const categoryCounts = events.reduce<Record<string, number>>((acc, item) => {
  const cat = normalizeCategory(item.category);
  acc[cat] = (acc[cat] ?? 0) + 1;
  return acc;
}, {});

const categories = Object.keys(categoryCounts);
---

<BaseLayout
  title="行動紀實｜捍衛全台學權行動 ADSR"
  description="ADSR 捍衛全台學權行動的歷次活動與抗爭紀實，包含教育部記者會、靜坐抗議、全國學生座談會與跨校學權行動。"
>
  <section class="relative border-b border-white/10 bg-grid-pattern py-16">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
      <p class="font-[Montserrat] text-xs font-bold uppercase tracking-[0.2em] text-red-500">ACTION TIMELINE</p>
      <h1 class="mt-2 text-3xl font-black text-white sm:text-5xl">行動紀實</h1>
      <p class="mx-auto mt-4 max-w-2xl text-base text-gray-400">
        紀錄 ADSR 自創立以來每一場與學生站在一起的和平示威、記者會、靜坐與倡議行動。
      </p>

      <!-- Category Filter -->
      <div class="mt-8 flex flex-wrap justify-center gap-2" role="group" aria-label="依分類篩選行動">
        <button
          type="button"
          data-filter="all"
          class="event-filter-btn rounded-full border border-red-500 bg-red-600 px-4 py-1.5 text-xs font-bold text-white transition"
        >
          全部 ({events.length})
        </button>
        {
          categories.map((cat) => (
            <button
              type="button"
              data-filter={cat}
              class="event-filter-btn rounded-full border border-white/15 bg-white/5 px-4 py-1.5 text-xs font-semibold text-gray-300 transition hover:border-red-500/50 hover:text-white"
            >
              #{cat} ({categoryCounts[cat]})
            </button>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Timeline -->
  <section class="mx-auto max-w-4xl px-4 pt-14 sm:px-6 lg:px-8">
    <div class="relative border-l border-white/15 pl-6 sm:pl-10 space-y-8" id="events-timeline">
      {
        events.map((ev) => {
          const cat = normalizeCategory(ev.category);
          const color = getCategoryColor(cat);
          return (
            <article
              class="event-item relative"
              data-category={cat}
            >
              <!-- Timeline Dot -->
              <span
                aria-hidden="true"
                class="absolute -left-[31px] sm:-left-[47px] top-6 h-3.5 w-3.5 rounded-full ring-4 ring-[#090b10]"
                style={`background-color: ${color};`}
              />

              <div
                class="glass-panel glass-panel-hover rounded-2xl p-6 sm:p-7"
                style={`border-left: 4px solid ${color};`}
              >
                <div class="flex flex-wrap items-center justify-between gap-2">
                  <time
                    datetime={ev.date}
                    class="inline-flex items-center gap-1.5 font-[Montserrat] text-xs font-bold tracking-wider text-gray-400"
                  >
                    <svg class="h-3.5 w-3.5 text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                      />
                    </svg>
                    {ev.date.replace(/-/g, ' / ')}
                  </time>
                  <span
                    class="rounded-full px-3 py-0.5 text-xs font-semibold"
                    style={`background-color: ${color}24; color: ${color}; border: 1px solid ${color}55;`}
                  >
                    #{cat}
                  </span>
                </div>

                <h2 class="mt-3 text-xl font-bold text-white sm:text-2xl">{ev.title}</h2>
                <p class="mt-3 text-sm leading-7 text-gray-300 sm:text-base">{ev.summary}</p>

                {
                  ev.link && (
                    <div class="mt-5">
                      <a
                        href={ev.link}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-1.5 rounded-lg border border-red-500/30 bg-red-600/10 px-4 py-2 text-sm font-semibold text-red-400 transition hover:bg-red-600 hover:text-white"
                      >
                        查看行動紀錄
                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                          />
                        </svg>
                      </a>
                    </div>
                  )
                }
              </div>
            </article>
          );
        })
      }
    </div>
  </section>
</BaseLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.event-filter-btn');
  const items = document.querySelectorAll<HTMLElement>('.event-item');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = btn.dataset.filter || 'all';

      buttons.forEach((b) => {
        const isSelected = b === btn;
        b.classList.toggle('bg-red-600', isSelected);
        b.classList.toggle('border-red-500', isSelected);
        b.classList.toggle('text-white', isSelected);
        b.classList.toggle('font-bold', isSelected);
        b.classList.toggle('bg-white/5', !isSelected);
        b.classList.toggle('border-white/15', !isSelected);
        b.classList.toggle('text-gray-300', !isSelected);
      });

      items.forEach((item) => {
        const match = target === 'all' || item.dataset.category === target;
        item.classList.toggle('hidden', !match);
      });
    });
  });
</script>
