---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { withBase, toAbsoluteUrl } from '@/utils/url';
import { buildWebPageJsonLd } from '@/utils/seo';
import {
  getCategoryColor,
  normalizeCategory,
  formatDateISO,
  estimateReadingMinutes,
} from '@/utils/categories';

const papers = (await getCollection('papers')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const categoryCounts = papers.reduce<Record<string, number>>((acc, paper) => {
  const cat = normalizeCategory(paper.data.category);
  acc[cat] = (acc[cat] ?? 0) + 1;
  return acc;
}, {});

const categories = Object.keys(categoryCounts);

const pageTitle = '倡議文章｜學生權益、教育改革｜捍衛全台學權行動 ADSR';
const pageDescription =
  'ADSR 捍衛全台學權行動的所有倡議文章，聚焦學生權益、教育改革、反威權與台灣學生運動，持續更新，推動學權進步。';
const pageUrl = toAbsoluteUrl('/papers/', Astro.site);

const papersJsonLd = buildWebPageJsonLd({
  type: 'CollectionPage',
  name: pageTitle,
  description: pageDescription,
  url: pageUrl,
  site: Astro.site,
  ...(papers.length > 0
    ? {
        mainEntity: {
          '@type': 'ItemList',
          numberOfItems: papers.length,
          itemListElement: papers.map((paper, index) => ({
            '@type': 'ListItem',
            position: index + 1,
            name: paper.data.title,
            url: toAbsoluteUrl(`/papers/${paper.id}/`, Astro.site),
          })),
        },
      }
    : {}),
});
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  ogImage="/og/papers.png"
  ogImageAlt="倡議文章｜捍衛全台學權行動 ADSR — 台灣教育政策、校園權益與學生自主議題論述"
  breadcrumbs={[
    { name: '首頁', href: '/' },
    { name: '倡議文章', href: '/papers/' },
  ]}
  jsonLd={papersJsonLd}
>
  <section class="border-b border-white/10 bg-grid-pattern py-16">
    <div class="mx-auto max-w-5xl px-4 text-center sm:px-6 lg:px-8">
      <p class="font-[Montserrat] text-xs font-bold uppercase tracking-[0.2em] text-red-500">ADVOCACY PAPERS</p>
      <h1 class="mt-2 text-3xl font-black text-white sm:text-5xl">倡議文章</h1>
      <p class="mx-auto mt-4 max-w-2xl text-base text-gray-400">
        深度剖析台灣教育政策、校園霸凌、升學主義與學生權利議題，以理性論述累積改革能量。
      </p>

      {
        papers.length > 0 && (
          <>
            <!-- Search Input -->
            <div class="mx-auto mt-8 max-w-md">
              <label for="paper-search" class="sr-only">搜尋倡議文章</label>
              <div class="relative">
                <svg
                  class="pointer-events-none absolute top-1/2 left-3.5 h-4 w-4 -translate-y-1/2 text-gray-400"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
                <input
                  id="paper-search"
                  type="search"
                  placeholder="搜尋標題、關鍵字或議題..."
                  class="w-full rounded-xl border border-white/15 bg-[#101522] py-2.5 pr-4 pl-10 text-sm text-white placeholder-gray-500 outline-none transition focus:border-red-500 focus:ring-2 focus:ring-red-500/25"
                />
              </div>
            </div>

            <!-- Category Filter -->
            <div class="mt-5 flex flex-wrap justify-center gap-2" role="group" aria-label="依分類篩選文章">
              <button
                type="button"
                data-filter="all"
                class="paper-filter-btn rounded-full border border-red-500 bg-red-600 px-4 py-1.5 text-xs font-bold text-white transition"
              >
                全部 ({papers.length})
              </button>
              {categories.map((cat) => (
                <button
                  type="button"
                  data-filter={cat}
                  class="paper-filter-btn rounded-full border border-white/15 bg-white/5 px-4 py-1.5 text-xs font-semibold text-gray-300 transition hover:border-red-500/50 hover:text-white"
                >
                  #{cat} ({categoryCounts[cat]})
                </button>
              ))}
            </div>
          </>
        )
      }
    </div>
  </section>

  <!-- Papers Grid -->
  <section class="mx-auto max-w-5xl px-4 pt-12 sm:px-6 lg:px-8">
    {
      papers.length === 0 ? (
        <div class="rounded-2xl border border-white/10 bg-white/5 px-6 py-16 text-center">
          <p class="text-lg font-semibold text-gray-200">目前尚無倡議文章</p>
          <p class="mt-2 text-sm text-gray-400">新文章正在籌備中，敬請期待後續發布。</p>
        </div>
      ) : (
        <div id="papers-list" class="grid gap-6">
          {papers.map((paper) => {
            const cat = normalizeCategory(paper.data.category);
            const color = getCategoryColor(cat);
            const readMins = estimateReadingMinutes(paper.body ?? '');
            const searchBlob = `${paper.data.title} ${paper.data.description} ${cat}`.toLowerCase();

            return (
              <a
                href={withBase(`/papers/${paper.id}/`)}
                data-category={cat}
                data-search={searchBlob}
                class="paper-card glass-panel glass-panel-hover group flex flex-col overflow-hidden rounded-2xl sm:flex-row"
                style={`border-left: 4px solid ${color};`}
              >
                {paper.data.thumbnail && (
                  <div class="relative aspect-[16/10] w-full shrink-0 overflow-hidden bg-gray-900 sm:aspect-auto sm:w-64">
                    <img
                      src={paper.data.thumbnail}
                      alt={paper.data.title}
                      loading="lazy"
                      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                    />
                  </div>
                )}

                <div class="flex flex-1 flex-col justify-between p-6">
                  <div>
                    <div class="flex flex-wrap items-center gap-2.5 text-xs">
                      <span
                        class="rounded-full px-2.5 py-0.5 font-semibold"
                        style={`background-color: ${color}24; color: ${color}; border: 1px solid ${color}55;`}
                      >
                        #{cat}
                      </span>
                      <time datetime={formatDateISO(paper.data.date)} class="font-[Montserrat] text-gray-400">
                        {formatDateISO(paper.data.date)}
                      </time>
                      <span class="text-gray-600">·</span>
                      <span class="text-gray-400">約 {readMins} 分鐘閱讀</span>
                    </div>

                    <h2 class="mt-3 text-xl font-bold text-white transition group-hover:text-red-400 sm:text-2xl">
                      {paper.data.title}
                    </h2>

                    <p class="mt-2.5 line-clamp-3 text-sm leading-relaxed text-gray-300">
                      {paper.data.description}
                    </p>
                  </div>

                  <div class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-red-400">
                    閱讀全文
                    <svg
                      class="h-4 w-4 transition-transform group-hover:translate-x-1"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                    </svg>
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      )
    }

    <!-- Empty State -->
    <div
      id="papers-empty"
      class="hidden rounded-2xl border border-white/10 bg-white/5 px-6 py-14 text-center"
    >
      <p class="text-lg font-semibold text-gray-200">找不到符合條件的文章</p>
      <p class="mt-1 text-sm text-gray-400">請嘗試其他關鍵字或切換文章分類。</p>
      <button
        type="button"
        id="reset-filters"
        class="mt-5 rounded-lg bg-red-600 px-4 py-2 text-xs font-bold text-white transition hover:bg-red-500"
      >
        清除篩選條件
      </button>
    </div>
  </section>
</BaseLayout>

<script>
  const searchInput = document.getElementById('paper-search') as HTMLInputElement | null;
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.paper-filter-btn');
  const cards = document.querySelectorAll<HTMLElement>('.paper-card');
  const emptyBox = document.getElementById('papers-empty');
  const resetBtn = document.getElementById('reset-filters');

  let activeCategory = 'all';
  let searchQuery = '';

  const applyFilters = () => {
    let visibleCount = 0;
    cards.forEach((card) => {
      const matchCat = activeCategory === 'all' || card.dataset.category === activeCategory;
      const matchQuery = !searchQuery || (card.dataset.search ?? '').includes(searchQuery);
      const show = matchCat && matchQuery;
      card.classList.toggle('hidden', !show);
      if (show) visibleCount++;
    });

    if (emptyBox) {
      emptyBox.classList.toggle('hidden', visibleCount > 0);
    }
  };

  const setActiveBtn = (targetCat: string) => {
    filterBtns.forEach((btn) => {
      const isSelected = (btn.dataset.filter || 'all') === targetCat;
      btn.classList.toggle('bg-red-600', isSelected);
      btn.classList.toggle('border-red-500', isSelected);
      btn.classList.toggle('text-white', isSelected);
      btn.classList.toggle('font-bold', isSelected);
      btn.classList.toggle('bg-white/5', !isSelected);
      btn.classList.toggle('border-white/15', !isSelected);
      btn.classList.toggle('text-gray-300', !isSelected);
    });
  };

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      activeCategory = btn.dataset.filter || 'all';
      setActiveBtn(activeCategory);
      applyFilters();
    });
  });

  searchInput?.addEventListener('input', (e) => {
    searchQuery = (e.target as HTMLInputElement).value.trim().toLowerCase();
    applyFilters();
  });

  resetBtn?.addEventListener('click', () => {
    activeCategory = 'all';
    searchQuery = '';
    if (searchInput) searchInput.value = '';
    setActiveBtn('all');
    applyFilters();
  });
</script>
