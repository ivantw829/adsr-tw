---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { withBase, toAbsoluteUrl } from '@/utils/url';
import {
  getCategoryColor,
  normalizeCategory,
  formatDateZh,
  formatDateISO,
  estimateReadingMinutes,
} from '@/utils/categories';

export async function getStaticPaths() {
  const papers = (await getCollection('papers')).sort(
    (a, b) => b.data.date.getTime() - a.data.date.getTime()
  );

  return papers.map((paper, idx) => ({
    params: { slug: paper.id },
    props: {
      paper,
      prevPaper: idx < papers.length - 1 ? papers[idx + 1] : null,
      nextPaper: idx > 0 ? papers[idx - 1] : null,
    },
  }));
}

const { paper, prevPaper, nextPaper } = Astro.props;
const { Content } = await render(paper);

const cat = normalizeCategory(paper.data.category);
const color = getCategoryColor(cat);
const readMins = estimateReadingMinutes(paper.body ?? '');
const isoDate = formatDateISO(paper.data.date);

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: paper.data.title,
  description: paper.data.description,
  datePublished: isoDate,
  author: {
    '@type': 'Organization',
    name: paper.data.author,
  },
  publisher: {
    '@type': 'Organization',
    name: '捍衛全台學權行動 ADSR',
    logo: {
      '@type': 'ImageObject',
      url: toAbsoluteUrl('/assets/logo360.png', Astro.site),
    },
  },
  image: paper.data.thumbnail ? [paper.data.thumbnail] : [toAbsoluteUrl('/assets/logo360.png', Astro.site)],
  inLanguage: 'zh-TW',
};
---

<BaseLayout
  title={`${paper.data.title}｜倡議文章｜捍衛全台學權行動 ADSR`}
  description={paper.data.description}
  ogImage={paper.data.thumbnail ?? '/assets/logo360.png'}
  ogType="article"
  jsonLd={articleJsonLd}
>
  <article class="mx-auto max-w-3xl px-4 pt-10 pb-16 sm:px-6 lg:px-8">
    <!-- Breadcrumb -->
    <nav aria-label="麵包屑導覽" class="mb-8 flex items-center gap-2 text-xs text-gray-400">
      <a href={withBase('/')} class="transition hover:text-white">首頁</a>
      <span>/</span>
      <a href={withBase('/papers/')} class="transition hover:text-white">倡議文章</a>
      <span>/</span>
      <span class="truncate text-gray-300">{paper.data.title}</span>
    </nav>

    <!-- Article Header -->
    <header class="space-y-5">
      <div class="flex flex-wrap items-center gap-3 text-xs">
        <span
          class="rounded-full px-3 py-1 font-bold"
          style={`background-color: ${color}24; color: ${color}; border: 1px solid ${color}55;`}
        >
          #{cat}
        </span>
        <time datetime={isoDate} class="text-gray-400">{formatDateZh(paper.data.date)}</time>
        <span class="text-gray-600">·</span>
        <span class="text-gray-400">約 {readMins} 分鐘閱讀</span>
        <span class="text-gray-600">·</span>
        <span class="text-gray-400">{paper.data.author}</span>
      </div>

      <h1 class="text-3xl font-black leading-tight text-white sm:text-4xl">
        {paper.data.title}
      </h1>

      <p class="rounded-xl border-l-4 border-red-600 bg-white/[0.04] px-5 py-4 text-base leading-relaxed text-gray-300">
        {paper.data.description}
      </p>

      <!-- Share / Copy Link Bar -->
      <div class="flex items-center justify-between border-y border-white/10 py-3.5">
        <a
          href={withBase('/papers/')}
          class="inline-flex items-center gap-1.5 text-xs font-semibold text-gray-400 transition hover:text-red-400"
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 17l-5-5m0 0l5-5m-5 5h12" />
          </svg>
          返回文章列表
        </a>

        <button
          type="button"
          id="copy-link-btn"
          class="inline-flex items-center gap-1.5 rounded-lg border border-white/15 bg-white/5 px-3 py-1.5 text-xs font-semibold text-gray-200 transition hover:border-red-500/50 hover:text-white"
        >
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"
            />
          </svg>
          <span id="copy-link-label">複製文章連結</span>
        </button>
      </div>
    </header>

    <!-- Article Body -->
    <div class="article-prose prose prose-invert max-w-none mt-10">
      <Content />
    </div>

    <!-- Prev / Next Navigation -->
    <nav
      aria-label="上下篇文章導覽"
      class="mt-16 grid gap-4 border-t border-white/10 pt-8 sm:grid-cols-2"
    >
      {
        prevPaper ? (
          <a
            href={withBase(`/papers/${prevPaper.id}/`)}
            class="glass-panel glass-panel-hover flex flex-col rounded-xl p-5"
          >
            <span class="text-xs font-semibold text-gray-400">← 較早文章</span>
            <span class="mt-1.5 line-clamp-2 text-sm font-bold text-white">{prevPaper.data.title}</span>
          </a>
        ) : (
          <div />
        )
      }

      {
        nextPaper && (
          <a
            href={withBase(`/papers/${nextPaper.id}/`)}
            class="glass-panel glass-panel-hover flex flex-col rounded-xl p-5 sm:text-right"
          >
            <span class="text-xs font-semibold text-gray-400">較新文章 →</span>
            <span class="mt-1.5 line-clamp-2 text-sm font-bold text-white">{nextPaper.data.title}</span>
          </a>
        )
      }
    </nav>
  </article>
</BaseLayout>

<script>
  const copyBtn = document.getElementById('copy-link-btn');
  const copyLabel = document.getElementById('copy-link-label');

  copyBtn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(window.location.href);
      if (copyLabel) {
        copyLabel.textContent = '已複製連結！';
        setTimeout(() => {
          copyLabel.textContent = '複製文章連結';
        }, 2000);
      }
    } catch {
      if (copyLabel) copyLabel.textContent = '請手動複製網址';
    }
  });
</script>
