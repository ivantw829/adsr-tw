---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { BYLAWS_CHAPTERS } from '@/data/bylaws';
---

<BaseLayout
  title="組織章程｜ADSR 共識大會｜捍衛全台學權行動 ADSR"
  description="ADSR 捍衛全台學權行動共識大會章程與組織規範，詳列組織架構、權限分工、團隊規範、禁止事項、經費管理與財務制度。"
>
  <section class="border-b border-white/10 bg-grid-pattern py-16">
    <div class="mx-auto max-w-5xl px-4 text-center sm:px-6 lg:px-8">
      <p class="font-[Montserrat] text-xs font-bold uppercase tracking-[0.2em] text-red-500">ORGANIZATION BYLAWS</p>
      <h1 class="mt-2 text-3xl font-black text-white sm:text-5xl">ADSR 共識大會組織章程</h1>
      <p class="mx-auto mt-4 max-w-2xl text-base text-gray-400">
        明定捍衛全台學權行動之組織架構、權力制衡、團隊紀律與財務透明制度，確保行動穩定且可受公評。
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pt-12 sm:px-6 lg:px-8">
    <div class="grid gap-10 lg:grid-cols-[260px_1fr]">
      <!-- Sticky Table of Contents -->
      <aside class="lg:sticky lg:top-24 lg:self-start">
        <nav aria-label="章程目錄" class="glass-panel rounded-2xl p-5">
          <h2 class="text-xs font-bold uppercase tracking-widest text-red-400">章節目錄</h2>
          <ul class="mt-4 space-y-3 text-sm">
            {
              BYLAWS_CHAPTERS.map((chapter) => (
                <li>
                  <a
                    href={`#${chapter.id}`}
                    class="block font-bold text-gray-200 transition hover:text-red-400"
                  >
                    {chapter.chapterLabel}　{chapter.title}
                  </a>
                  <ul class="mt-1.5 space-y-1 border-l border-white/10 pl-3 text-xs text-gray-400">
                    {chapter.sections.map((section) => (
                      <li>
                        <a href={`#${section.id}`} class="block py-0.5 transition hover:text-white">
                          {section.title}
                        </a>
                      </li>
                    ))}
                  </ul>
                </li>
              ))
            }
          </ul>
        </nav>
      </aside>

      <!-- Bylaws Content -->
      <div class="space-y-12">
        {
          BYLAWS_CHAPTERS.map((chapter) => (
            <section id={chapter.id} class="scroll-mt-24 space-y-6">
              <div class="border-b border-white/10 pb-4">
                <span class="inline-block rounded-md bg-red-600/20 px-2.5 py-1 text-xs font-bold text-red-400">
                  {chapter.chapterLabel}
                </span>
                <h2 class="mt-2 text-2xl font-extrabold text-white sm:text-3xl">{chapter.title}</h2>
              </div>

              {chapter.sections.map((section) => (
                <div id={section.id} class="scroll-mt-24 space-y-5">
                  <h3 class="text-lg font-bold text-red-300">{section.title}</h3>

                  <div class="space-y-4">
                    {section.articles.map((article) => (
                      <article id={article.id} class="glass-panel rounded-2xl p-6 sm:p-7">
                        <h4 class="text-base font-bold text-white sm:text-lg">{article.title}</h4>

                        {article.intro && (
                          <p class="mt-3 text-sm leading-7 text-gray-300 sm:text-base">{article.intro}</p>
                        )}

                        {article.items && article.listType === 'decimal' && (
                          <ol class="mt-4 list-decimal space-y-2.5 pl-5 text-sm leading-7 text-gray-300 sm:text-base">
                            {article.items.map((item) => (
                              <li>
                                {item.label && <strong class="text-white">{item.label}</strong>}
                                {item.text}
                              </li>
                            ))}
                          </ol>
                        )}

                        {article.items && article.listType !== 'decimal' && (
                          <ul class="mt-4 list-disc space-y-2.5 pl-5 text-sm leading-7 text-gray-300 sm:text-base">
                            {article.items.map((item) => (
                              <li>
                                {item.label && <strong class="text-white">{item.label}</strong>}
                                {item.text}
                              </li>
                            ))}
                          </ul>
                        )}
                      </article>
                    ))}
                  </div>
                </div>
              ))}
            </section>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
